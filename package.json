{
  "name": "decky-portal",
  "version": "1.0.0",
  "description": "A Decky plugin that adds a portable in-game web portal for streaming, browsing, and media playback.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deck:build": "./scripts/build.sh",
    "deck:deploy": "./scripts/deploy.sh",
    "deck:builddeploy": "pnpm deck:build && pnpm deck:deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajustinjames/decky-portal.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck",
    "portal",
    "browser",
    "streaming"
  ],
  "author": "Aaron James",
  "contributors": [
    "Ross Squires <ross.squires@gmail.com> (original author of decky-pip)"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/ajustinjames/decky-portal/issues"
  },
  "homepage": "https://github.com/ajustinjames/decky-portal#readme",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.63.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "cotton-box": "^2.0.0",
    "cotton-box-react": "^2.0.0",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1"
  }
}
